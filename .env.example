# Shared
NODE_ENV=development
PROVIDER_MODE=fixture
# When PROVIDER_MODE=live and a live fetch fails: fall back to fixture with liveOk=false
# unless STRICT_LIVE=1 (then throw LiveProviderError).
STRICT_LIVE=0
# Force booking stub confirmations even when PROVIDER_MODE=live
# BOOKING_STUB=1
# BOOKING_STUB=0 means "do not use stub confirmations" — it does NOT enable 12306 submit.
# BOOKING_STUB=0
# Explicit opt-in for assistive 12306 submit (POST /orders/:id/submit). Default OFF.
# TRAIN_REAL_SUBMIT=0
# Stop before final 12306 confirmSingleForQueue (auth+prepare only); only applies when submit enabled
# TRAIN_BOOKING_DRY_RUN=1

# Database
DATABASE_URL=postgresql://ticket:ticket@localhost:5432/ticket_grab?schema=public

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_EXPIRES_IN=7d

# API
API_HOST=0.0.0.0
API_PORT=3001
CORS_ORIGIN=http://localhost:3000
WEB_BASE_URL=http://localhost:3000

# AES-256-GCM key material for traveler ID numbers + platform session cookie blobs.
# REQUIRED in production. Without it, values are stored with a plain: prefix (dev only).
# WARNING: sessionCookieEnc is SENSITIVE — prefer vaultRef when possible. Never store plaintext passwords.
ENCRYPTION_KEY=change-me-to-a-long-random-encryption-key

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001
WEB_PORT=3000

# SMTP (Mailhog locally)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@ticket-grab.local
SMTP_USER=
SMTP_PASS=

# Optional live overrides (assistive / public only)
# TRAIN_PUBLIC_API_URL=
# TRAIN_12306_QUERY_URL=
# TRAIN_STATION_JS_URL=
# SHOW_PUBLIC_API_URL=   # optional override; default live = Dianping/Gewara myshow detail+shows+tickets
# FLIGHT_PUBLIC_API_URL=

# --- Flight live providers (optional; OpenSky keyless fallback if unset) ---
# Amadeus self-service: https://developers.amadeus.com/ (free test keys ~5 min)
# AMADEUS_CLIENT_ID=
# AMADEUS_CLIENT_SECRET=
# AMADEUS_ENV=test
# Aviationstack: https://aviationstack.com/
# FLIGHT_API_KEY=
# Disable OpenSky ADS-B fallback: FLIGHT_OPENSKY=0
# RATE_LIMIT_REDIS=0

# Public self-register (0=disabled, admin creates accounts; 1=open for e2e/dev)
ALLOW_PUBLIC_REGISTER=1
