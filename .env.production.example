# =============================================================================
# Ticket Grab Cloud — PRODUCTION env template
# Copy to .env.production and fill every required value before `./scripts/prod-up.sh`
# API refuses to boot if JWT_SECRET / ENCRYPTION_KEY look like defaults when NODE_ENV=production
# =============================================================================

NODE_ENV=production

# --- Postgres (compose service names resolve inside the docker network) ---
POSTGRES_USER=ticket
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_DB_PASSWORD
POSTGRES_DB=ticket_grab
# Full URL is assembled in docker-compose.prod.yml; for non-compose hosts set:
# DATABASE_URL=postgresql://ticket:PASSWORD@db-host:5432/ticket_grab?schema=public

# --- Redis ---
# REDIS_URL=redis://redis:6379

# --- Auth / crypto (REQUIRED — must NOT be change-me / dev / short) ---
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_STRING
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=REPLACE_WITH_64_CHAR_RANDOM_STRING

# --- Public origins (HTTPS in real prod) ---
CORS_ORIGIN=https://app.example.com
WEB_BASE_URL=https://app.example.com
NEXT_PUBLIC_API_URL=https://api.example.com

# --- Live data (recommended for To-C) ---
PROVIDER_MODE=live
# Not stub confirmations. Does NOT by itself enable 12306 submit.
BOOKING_STUB=0
# Assistive 12306 submit kill-switch — keep 0 for ToC honesty unless ops explicitly enable.
TRAIN_REAL_SUBMIT=0
TRAIN_BOOKING_DRY_RUN=0
STRICT_LIVE=0

# --- Flights (pick one — see README「5 分钟启用实时机票」) ---
# Amadeus self-service (free test key at https://developers.amadeus.com/)
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_ENV=test
# AMADEUS_HOSTNAME=test.api.amadeus.com
# Or Aviationstack:
FLIGHT_API_KEY=
# Or your own JSON proxy returning { items: ShortlistItem[] }:
FLIGHT_PUBLIC_API_URL=
# Keyless ADS-B fallback (no prices). Set 0 to disable:
FLIGHT_OPENSKY=1

# Optional public overrides for train/show
# TRAIN_PUBLIC_API_URL=
# TRAIN_12306_QUERY_URL=
# TRAIN_STATION_JS_URL=
# SHOW_PUBLIC_API_URL=

# --- SMTP (real provider — Mailhog is optional via compose profile "mail") ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM=noreply@example.com
SMTP_USER=
SMTP_PASS=

# --- Ops ---
LOG_LEVEL=info
RATE_LIMIT_REDIS=1
API_HOST=0.0.0.0
API_PORT=3001

# Public self-register for ToC (default on). Set 0 only if you want admin-only invites.
ALLOW_PUBLIC_REGISTER=1
